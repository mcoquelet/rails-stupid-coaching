<form action="/answer" method="get" data-turbo="false">
  <label for="question" class="font-weight-light">Ask your coach anything</label>
  <div class="input-group my-3">
    <input type="text" id="question" class="form-control" name="question">
    <div class="input-group-append">
      <button type="submit" class="btn btn-primary" value="ask">Ask</button>
    </div>
  </div>
</form>
